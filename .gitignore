*.swp
*~

# ---- Not ours to republish ----
peers/
*.SEED-COPY.*

# ---- scratch: verification scripts and notes only ----
# (data dumps, text caches and paper extracts are excluded by rsync;
#  this belt-and-braces rule keeps them out if anything slips through)
scratch/**/*.txt
scratch/txtcache/
scratch/polyidx/
